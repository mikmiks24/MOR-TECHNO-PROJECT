TMS_ADMIN_USERNAME=admin
TMS_ADMIN_PASSWORD=change-this-password

# Keep the real Gemini key on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ESP32-CAM capture endpoint used by /api/visual/analyze-from-camera.
ESP32_CAPTURE_URL=http://192.168.1.50/capture

# Comma-separated origins for browser clients. Use a specific frontend URL in production.
CORS_ORIGINS=*

# Optional storage overrides.
TMS_DATABASE_PATH=data/tms.db
TMS_EVIDENCE_DIR=data/evidence
